{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persona-wire-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // 2 時間ごとに、収集先（Notion・RSS）から新着を読み、Supabase の articles に登録する（src/index.ts の scheduled）。
  // Cron は UTC で書く。UTC の奇数時 = 日本時間の偶数時（0:00、2:00 … 22:00）
  "triggers": { "crons": ["0 1-23/2 * * *"] },
  "vars": {
    "SUPABASE_URL": "https://dxfzlwxibsdkaighzzjo.supabase.co",
    // バッチで登録する記事の 1 日（日本時間）の上限。RSS・note・Notion の合計
    "DAILY_LIMIT": "100",
    // 却下した記事を、最後の更新（却下した操作を含む）から何日で削除するか
    "PURGE_REJECTED_DAYS": "5",
    // 「今すぐ収集」ボタンを置く管理画面の URL（カンマ区切り）。ここからのブラウザの呼び出しだけを受け付ける
    "ALLOWED_ORIGINS": "https://persona-wire-admin.tryoma0227.workers.dev,http://localhost:5173"
  },
  // 秘密情報は vars に書かず、wrangler secret put で登録する（README.md を参照）
  //   SUPABASE_SECRET_KEY  Supabase の Secret key（RLS を無視して書き込める。絶対に公開しない）
  //   NOTION_TOKEN         Notion の内部インテグレーションのトークン
  //   RUN_TOKEN            手動実行（POST /run）用の合言葉
  "observability": { "enabled": true }
}
