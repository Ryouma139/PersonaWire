{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persona-wire-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // 読者向けの公開サイト（Persona Wire、日本語）。公開中の記事と掲載中の商品を Supabase から読み、ページを組み立てて返す。
  // ページの組み立ては src/app.ts（海外向けの site_adoutor/ と共通）。ロゴなどの画像は public/ から、そのまま配信する
  "assets": { "directory": "./public" },
  "vars": {
    "SUPABASE_URL": "https://dxfzlwxibsdkaighzzjo.supabase.co",
    // 誰が使ってもよい公開用の鍵（Publishable key）。公開用のビューと、クリックを記録する関数しか使えない。
    // Secret key は、このサイトには絶対に置かない
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ov9sVqqpNK_2QtCtn33dCA_qUag_JAO",
    // DB の sites.code。サイト名・キャッチコピー・運営者情報・問い合わせ先は、DB の sites の行を書き換えて変える
    "SITE_CODE": "persona-wire"
  },
  "observability": { "enabled": true }
}
